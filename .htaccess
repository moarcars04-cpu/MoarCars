# ----------------------------------------------------------------------
# Moar Cars - Production .htaccess configuration for Hostinger
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Allow direct access to real existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Route /api requests to api/index.php (prevent internal recursion loops)
  RewriteCond %{REQUEST_URI} !^/api/index\.php
  RewriteRule ^api(?:/(.*))?$ /api/index.php [QSA,L]

  # 3. Redirect all other frontend routes to index.html for React SPA
  RewriteRule ^ /index.html [L]
</IfModule>
