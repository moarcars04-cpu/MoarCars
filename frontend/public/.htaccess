# ----------------------------------------------------------------------
# Moar Cars - Production .htaccess configuration for Hostinger
# ----------------------------------------------------------------------

# Enable Node.js Passenger Application (Hostinger App Engine)
PassengerEnabled on
PassengerAppType node
PassengerStartupFile server.js

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Allow direct access to real existing files and directories (CSS, JS, images, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Do NOT rewrite /api requests so Passenger handles backend routes
  RewriteCond %{REQUEST_URI} ^/api [NC]
  RewriteRule ^ - [L]

  # 3. Redirect all other frontend routes (e.g. /admin) to index.html for React SPA
  RewriteRule ^ index.html [L]
</IfModule>

# Prevent directory browsing
Options -Indexes

# Proper MIME types
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
</IfModule>
