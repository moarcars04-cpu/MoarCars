# ----------------------------------------------------------------------
# Moar Cars - Production .htaccess configuration for Hostinger
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Route all /api/* requests to native PHP backend handler
  RewriteRule ^api/(.*)$ api/index.php [QSA,L]
  RewriteRule ^api$ api/index.php [QSA,L]

  # 2. Allow direct access to real existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Redirect all other frontend routes (e.g. /admin) to index.html for React SPA
  RewriteRule ^ index.html [L]
</IfModule>

# Prevent directory browsing
Options -Indexes

# Proper MIME types
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
</IfModule>
