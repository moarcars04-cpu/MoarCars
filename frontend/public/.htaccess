# ----------------------------------------------------------------------
# Moar Cars - Production .htaccess configuration for Hostinger
# ----------------------------------------------------------------------

# Enable Node.js Passenger Application (Hostinger App Engine)
<IfModule mod_passenger.c>
  PassengerEnabled on
  PassengerAppType node
  PassengerStartupFile server.js
</IfModule>

# URL Rewriting for React SPA Routing (Fixes 404 on direct /admin visits)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow direct access to real files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redirect all other routes (like /admin) to index.html for React SPA
  RewriteRule ^ index.html [L]
</IfModule>

# Prevent directory browsing
Options -Indexes

# Proper MIME types
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
</IfModule>
